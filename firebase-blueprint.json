{
  "entities": {
    "User": {
      "title": "User",
      "description": "A scholar's profile containing registration details and registration timestamps",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "photoURL": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "createdAt"
      ]
    },
    "Draft": {
      "title": "Draft",
      "description": "An academic paper draft containing rich prose content, metadata, and citation references",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "bibliography": {
          "type": "array"
        },
        "citationStyle": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "content",
        "userId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Saves user profile settings and state key alignment"
    },
    "users/{userId}/drafts/{draftId}": {
      "schema": "Draft",
      "description": "Academic papers authored and edited by the researcher"
    }
  }
}
